// Shared conformance-harness schema.
//
// This is the SINGLE source of truth for the dual-dialect client conformance
// corpus. The harness generates a client from it once per dialect (PostgreSQL
// and SQLite) via the generator's `dialect` option — the datasource `provider`
// below is not consulted for codegen, only the option passed in global-setup.ts.
//
// DDL for each dialect lives in helpers/dialects.ts and MUST stay in sync with
// the models here (notably the `publishedAt` column exercised by the DateTime
// `@default` corpus case).

datasource db {
  provider = "postgresql"
  url      = "postgresql://test:test@localhost:5432/test"
}

generator client {
  provider = "ork"
  output   = "./generated"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  score       BigInt   @default(0)
  createdAt   DateTime @default(now())
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  profile     Profile?
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
