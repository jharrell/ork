{
  "private": true,
  "name": "ork",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "watch": "pnpm -r run dev && WATCH=true pnpm -r --parallel --stream run dev",
    "demo:postgres": "pnpm --filter @ork-orm/example-basic demo",
    "publish-dryrun": "tsx scripts/publish.ts --dry-run",
    "publish": "tsx scripts/publish.ts",
    "test": "pnpm -r test",
    "preinstall": "node ./scripts/only-allow-pnpm.js pnpm",
    "precommit": "lint-staged",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format": "prettier --write .",
    "prettier-check": "prettier --check .",
    "prepare": "husky",
    "clean": "git clean -fdx -e /.envrc.local -e /sandbox"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.0",
    "@eslint/js": "9.30.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "execa": "5.1.1",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "2.8.8",
    "tsx": "4.19.3",
    "typescript": "5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "lint-staged": {
    "*.{md,yml,json}": "prettier --check",
    "*.{js,ts}": [
      "eslint"
    ]
  }
}
